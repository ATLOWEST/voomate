# =============================================================================
# Soniq — environment contract
#
# Copy to `.env` and fill in. `.env` is gitignored and must NEVER be committed.
# Every variable here is validated at boot by packages/core/src/env.ts — the
# process refuses to start if something required is missing or malformed.
#
# Nothing here is wired to a live service yet. These are the slots that the
# Supabase / AWS integration phase will fill.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=debug
VOICE_LOG_LEVEL=INFO

# --- API server --------------------------------------------------------------
API_PORT=4000
API_HOST=0.0.0.0
# Comma-separated origins allowed to call the control-plane API (the dashboard).
API_CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Comma-separated proxy CIDRs allowed to supply X-Forwarded-For. Keep empty when direct.
API_TRUST_PROXY_CIDRS=

# --- Supabase (auth + Postgres) ----------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=
# Safe to expose to the browser. Row Level Security is what protects the data.
SUPABASE_ANON_KEY=
# SERVER ONLY. Bypasses RLS entirely. Never ship this to the dashboard or widget.
SUPABASE_SERVICE_ROLE_KEY=
# OPTIONAL — leave empty unless you know you need it.
# The API verifies JWTs against the project's published signing keys
# (/auth/v1/.well-known/jwks.json), so it needs no secret to check a signature and
# picks up key rotations by itself. Set this only for a legacy project still signing
# with the shared HS256 secret; a symmetric secret is weaker, because anything that
# can verify a token with it can also mint one.
SUPABASE_JWT_SECRET=

# Administrator-only Supabase Auth / Resend SMTP provisioning. These values are for
# scripts/configure-supabase-resend-smtp.mjs only; never expose them to the browser.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
RESEND_API_KEY=
AUTH_FROM_EMAIL=
AUTH_SENDER_NAME=Voomate

# Direct Postgres connection for Drizzle migrations (pooler URL for the app,
# direct URL for migrations — Supabase exposes both).
DATABASE_URL=
DATABASE_DIRECT_URL=

# --- AWS ---------------------------------------------------------------------
AWS_REGION=us-east-1
# Leave blank in deployed environments — use IAM task roles, not static keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Amazon Bedrock (the brain) ----------------------------------------------
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
# Amazon-only low-cost path for greetings, identity, and other low-risk conversation.
BEDROCK_LOW_COST_MODEL_ID=us.amazon.nova-micro-v1:0
# Cheaper/faster model for background jobs: summarisation, tagging, KB cleanup.
BEDROCK_UTILITY_MODEL_ID=us.amazon.nova-lite-v1:0
# Shared model-call admission limit across dashboard tasks. Set this below the Bedrock quota for
# the selected model and region; a deterministic UI route never consumes this capacity.
BEDROCK_MAX_REQUESTS_PER_MINUTE=20
# Customer-facing turns use Bedrock Inline Agents with managed orchestration, traces and
# return-control action groups. There is no raw model-call switch for this public runtime.

# --- Retrieval (embeddings; vectors live in Supabase) ------------------------
# Vectors are rows in Postgres, not an AWS resource — docs/adr/0005-supabase-pgvector.md.
# AWS's only role in retrieval is turning text into embeddings.
#
# Changing either value invalidates every stored embedding. A 512-d vector is not a
# truncation of a 1024-d one, so they must be regenerated, not migrated.
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024

# S3 bucket holding raw crawl artifacts, so re-chunking doesn't mean re-crawling
# the merchant's site. From the Soniq-<stage>-Storage stack output.
CRAWL_ARCHIVE_BUCKET=

# --- Amazon Transcribe (streaming STT) ---------------------------------------
TRANSCRIBE_REGION=us-east-1
# Same-region custom vocabulary for brand and product terms used by the streaming voice service.
TRANSCRIBE_VOCABULARY_NAME=voomate-web-agent-en-us
# Production speech gates. Raise confidence/min-volume for noisier deployment environments.
TRANSCRIBE_MIN_CONFIDENCE=0.78
VOICE_VAD_CONFIDENCE=0.82
VOICE_VAD_START_SECS=0.25
VOICE_VAD_STOP_SECS=0.65
VOICE_VAD_MIN_VOLUME=0.70

# --- Amazon Polly (streaming TTS) --------------------------------------------
POLLY_REGION=us-east-1
# generative | neural | standard — the ceiling we ask for; per-language
# availability is resolved at runtime by packages/i18n.
POLLY_PREFERRED_ENGINE=generative
# Pipecat Web Agent voice mode fails closed unless this remains generative.
POLLY_ENGINE=generative
POLLY_VOICE_ID=Danielle

# --- Amazon Chime SDK (WebRTC media transport) -------------------------------
CHIME_REGION=us-east-1
CHIME_MEDIA_REGION=us-east-1

# --- Widget security ---------------------------------------------------------
# Signs the short-lived session tokens the widget uses. 32+ random bytes.
WIDGET_TOKEN_SECRET=
# 32+ random characters; used only by the scheduled 48-hour image cleanup endpoint.
IMAGE_CLEANUP_SECRET=
WIDGET_TOKEN_TTL_SECONDS=900
# Public origin serving the Web Component and Next.js widget API routes.
WIDGET_ORIGIN=http://localhost:3001
# Public Pipecat runner origin returned to voice-enabled widgets.
VOICE_SERVICE_ORIGIN=http://localhost:7860
# Server-to-server callback target used by Pipecat for the existing harness/RAG/tool runtime.
WEB_AGENT_BACKEND_ORIGIN=http://localhost:3001

# Distributed per-widget-key + embedding-domain rate limiter. Required in production;
# development falls back to a process-local limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Dashboard (Next.js) -----------------------------------------------------
# NEXT_PUBLIC_* are compiled into the browser bundle. Never put a secret here.
# The marketing site uses this for its Sign in and Start building links.
# In production set it to the public dashboard domain, e.g. https://app.voomate.com.
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_WIDGET_ORIGIN=http://localhost:3001
# Dogfood only: public key of Voomate's own published Web Agent. This is a public,
# domain-restricted identifier, never a tenant secret. Leave blank for normal customer builds.
NEXT_PUBLIC_VOOMATE_DOGFOOD_AGENT_KEY=
# Base64-encoded 32-byte key used only to encrypt client live-read connection secrets at rest.
# Generate once for each environment: openssl rand -base64 32
CONNECT_ENCRYPTION_KEY=

# Meta app secret used to authenticate exact WhatsApp webhook request bodies.
WHATSAPP_WEBHOOK_SECRET=
