{
  "name": "@voomate/widget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Embeddable widget — tiny host-page loader plus the isolated iframe app",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:loader && npm run build:app && npm run build:voice",
    "build:loader": "vite build --config vite.loader.config.ts && node scripts/check-size.mjs",
    "build:app": "vite build --config vite.app.config.ts",
    "build:voice": "vite build --config vite.voice.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@pipecat-ai/client-js": "^1.13.1",
    "@pipecat-ai/small-webrtc-transport": "^1.10.8",
    "@voomate/core": "*"
  },
  "devDependencies": {
    "@voomate/config": "*",
    "terser": "^5.51.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.7"
  }
}
