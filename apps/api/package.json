    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/sensible": "^6.0.5",
    "@fastify/websocket": "^11.3.0",
    "@upstash/redis": "^1.38.4",
    "@voomate/connect": "*",
    "@voomate/core": "*",
    "@voomate/db": "*",
    "@voomate/i18n": "*",
    "bullmq": "^6.3.6",
    "cheerio": "^1.2.0",
    "domhandler": "^5.0.3",
    "fastify": "^5.12.5",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^6.0.0",
