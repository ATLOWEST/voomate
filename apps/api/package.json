{
  "name": "@soniq/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Control-plane API — tenancy, agents, knowledge, conversations, widget sessions",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
