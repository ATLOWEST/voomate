{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "forceConsistentCasingInFileNames": true,
    "verbatimModuleSyntax": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": false,
    "incremental": true,
    // Keep the incremental cache inside the output directory. Left at its default it sits
    // next to tsconfig.json and survives `rm -rf dist`, after which tsc reads a cache that
    // says everything is emitted, emits nothing, and exits 0 — a clean build that silently
    // produces no output. Storing it here makes deleting dist invalidate the cache too.
    "tsBuildInfoFile": "./dist/.tsbuildinfo",

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true
  },
  "exclude": ["node_modules", "dist", ".next", "build"]
}
