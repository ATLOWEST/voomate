{
  "name": "@voomate/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared contracts, types, errors and env validation. No I/O, no business logic.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./widget-protocol": {
      "types": "./dist/widget-protocol.d.ts",
      "default": "./dist/widget-protocol.js"
    },
    "./voice-protocol": {
      "types": "./dist/voice-protocol.d.ts",
      "default": "./dist/voice-protocol.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@voomate/i18n": "*",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@voomate/config": "*",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
