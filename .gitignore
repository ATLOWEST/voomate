# dependencies
node_modules/
.npm/

# build output
dist/
build/
out/
/output/
.next/
*.tsbuildinfo

# env & secrets — never commit these
.env
.env.*
!.env.example
*.pem
*.key
.aws/
credentials

# infra
cdk.out/
infra/cdk.out*/
cdk.context.json

# Generated release packages and CloudFormation synthesis output. Regenerate locally
# or in CI; do not commit compiled deployment artifacts to the source repository.
/.release-*/
/infra/cdk.out-*/

# logs
*.log
npm-debug.log*
logs/
!apps/dashboard/src/app/(app)/logs/
!apps/dashboard/src/app/(app)/logs/page.tsx

# test / coverage
coverage/
.nyc_output/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.venv/
evals/web-agent/results/

# editor / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# local scratch
/tmp/
/scratch/
.codebase-memory/

# Local secret material
/secrets/
*.secrets.*
/supabase_login_output.txt
/supabase/.temp/
